{
    "name": "sierratecnologia/pedreiro",
    "description": ":package_description",
    "keywords": [
        "sierratecnologia",
        "pedreiro"
    ],
    "homepage": "https://github.com/sierratecnologia/pedreiro",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricardo Sierra",
            "email": "ricardo@ricasolucoes.com.br",
            "homepage": "https://ricasolucoes.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ricardosierra/minify": "^2.0",
        "ricardosierra/validate": "^0.4.4",
        "ricardosierra/changelog": "~1.4",
        "sierratecnologia/muleta": "^2.0",
        "google/recaptcha": "^1.5",
        "kartik-v/bootstrap-fileinput": "^5.5",
        "creativeorange/gravatar": "^1.0",
        "league/csv": "^9.28",
        "rap2hpoutre/fast-excel": "^5.17",
        "maatwebsite/excel": "^4.0",
        "watson/validating": "^8.4",
        "ramsey/uuid": "^4.9",
        "yajra/laravel-datatables-buttons": "^13.2",
        "yajra/laravel-datatables-oracle": "^13.3",
        "spatie/laravel-validation-rules": "^3.4",
        "laracasts/presenter": "^0.2",
        "spatie/laravel-pjax": "^2.5",
        "spatie/laravel-sluggable": "^4.0",
        "anahkiasen/html-object": "^1.4",
        "laravel/helpers": "^1.8",
        "graham-campbell/markdown": "^16.1",
        "laracasts/flash": "^3.2",
        "jeroennoten/laravel-adminlte": "^4.0",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "orchestra/testbench": "^11.0",
        "phpro/grumphp": "^2.12",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "sierratecnologia/former": "Optional legacy form builder",
        "sierratecnologia/crudmaker": "Optional legacy CRUD generator",
        "sierratecnologia/collective-html": "Optional legacy form helpers"
    },
    "autoload": {
        "psr-4": {
            "Pedreiro\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pedreiro\\Test\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpro/grumphp": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pedreiro\\PedreiroServiceProvider"
            ],
            "aliases": {
                "Pedreiro": "Pedreiro\\PedreiroFacade"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "2.3.0"
}
